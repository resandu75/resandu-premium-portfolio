PORT=4000
# Set this to your deployed frontend's origin, without a trailing slash.
FRONTEND_ORIGIN=http://localhost:5173
# Long, unpredictable secret used for the private admin API. Never commit a real token.
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional: leave blank to store a SQLite database at backend/data/portfolio.sqlite
DATABASE_PATH=
